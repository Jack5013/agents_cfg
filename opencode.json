{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "ask",
          "project-analyst": "allow",
          "skill-manager": "allow",
          "system-architect": "allow",
          "sw-engineer": "allow",
          "embedded-engineer": "allow",
          "fpga-engineer": "allow",
          "sw-qa": "allow",
          "hw-qa": "allow",
          "devops-ci": "allow"
        }
      },
      "tools": {
        "skill": true
      }
    }
  },
  "permission": {
    "edit": "ask",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "pytest *": "allow",
      "ctest *": "allow"
    },
    "skill": {
      "*": "ask"
    }
  }
}
